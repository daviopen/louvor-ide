# Configurações do Firebase
# Copie este arquivo para .env e preencha com suas credenciais

VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id
VITE_FIREBASE_MEASUREMENT_ID=seu_measurement_id

# Firebase AI Logic — configuração client-side, sem Cloud Functions/servidor dedicado.
# A chave abaixo é a SITE KEY pública do reCAPTCHA Enterprise registrada no App Check.
# Nunca coloque secret key de reCAPTCHA, service account ou qualquer credencial privada aqui.
VITE_FIREBASE_APPCHECK_SITE_KEY=sua_site_key_publica_aqui

# Modelo Gemini usado pelo provider. O padrão do código é gemini-3.5-flash-lite.
VITE_FIREBASE_AI_MODEL=gemini-3.5-flash-lite
