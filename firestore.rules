rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function supportedProvider() { return signedIn() && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function eventPath(eventId) { return /databases/$(database)/documents/events/$(eventId); }
    function schedulePath(scheduleId) { return /databases/$(database)/documents/schedules/$(scheduleId); }
    function setlistPath(setlistId) { return /databases/$(database)/documents/setlists/$(setlistId); }
    function hasProfile() { return supportedProvider() && exists(profilePath(request.auth.uid)); }
    function profile() { return get(profilePath(request.auth.uid)); }
    function activeUser() { return supportedProvider() && hasProfile() && profile().data.active == true; }
    function hasRole(role) { return activeUser() && profile().data.role == role; }
    function hasClaim(claimName) { return signedIn() && claimName in request.auth.token && request.auth.token[claimName] == true; }

    function isSuperAdmin() {
      return activeUser() && (
        hasClaim('superAdmin') || ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN') || hasRole('SUPER_ADMIN')
      );
    }
    function isAdmin() {
      return isSuperAdmin() || (activeUser() && (
        hasClaim('admin') || ('role' in request.auth.token && request.auth.token.role == 'ADMIN') || hasRole('ADMIN')
      ));
    }

    function permissionPath(moduleName) {
      return /databases/$(database)/documents/permissions/$(request.auth.uid + '__' + moduleName);
    }
    function ownPermissionSlot(permissionId) {
      return activeUser() && permissionId in [
        request.auth.uid + '__dashboard',
        request.auth.uid + '__users',
        request.auth.uid + '__permissions',
        request.auth.uid + '__unavailability',
        request.auth.uid + '__events',
        request.auth.uid + '__schedules',
        request.auth.uid + '__setlists',
        request.auth.uid + '__songs',
        request.auth.uid + '__audit'
      ];
    }
    function explicitPermission(moduleName, acceptedLevels) {
      return activeUser()
        && (
          (
            exists(permissionPath(moduleName))
            && get(permissionPath(moduleName)).data.userId == request.auth.uid
            && get(permissionPath(moduleName)).data.module == moduleName
            && get(permissionPath(moduleName)).data.level in acceptedLevels
          )
          || (
            'permissions' in profile().data
            && profile().data.permissions is map
            && moduleName in profile().data.permissions
            && profile().data.permissions[moduleName] in acceptedLevels
          )
        );
    }
    function hasAccessProfile(profileIds) {
      return activeUser()
        && 'accessProfile' in profile().data
        && profile().data.accessProfile in profileIds;
    }
    function profileCanRead(moduleName) {
      return (moduleName in ['dashboard', 'unavailability', 'events', 'schedules', 'setlists', 'songs']
          && hasAccessProfile(['PARTICIPANT', 'MINISTER', 'DM', 'LEADER', 'ADMINISTRATOR']))
        || (moduleName in ['users', 'permissions', 'audit']
          && hasAccessProfile(['LEADER', 'ADMINISTRATOR']));
    }
    function profileCanEdit(moduleName) {
      return (moduleName == 'dashboard' && hasAccessProfile(['ADMINISTRATOR']))
        || (moduleName in ['users', 'permissions', 'audit'] && hasAccessProfile(['ADMINISTRATOR']))
        || (moduleName == 'unavailability' && hasAccessProfile(['PARTICIPANT', 'MINISTER', 'DM', 'LEADER', 'ADMINISTRATOR']))
        || (moduleName == 'events' && hasAccessProfile(['LEADER', 'ADMINISTRATOR']))
        || (moduleName == 'schedules' && hasAccessProfile(['LEADER', 'ADMINISTRATOR']))
        || (moduleName in ['setlists', 'songs'] && hasAccessProfile(['MINISTER', 'DM', 'LEADER', 'ADMINISTRATOR']));
    }
    function canRead(moduleName) { return isSuperAdmin() || profileCanRead(moduleName) || explicitPermission(moduleName, ['READ', 'EDIT']); }
    function canEdit(moduleName) {
      return isSuperAdmin()
        || profileCanEdit(moduleName)
        || (moduleName != 'schedules' && explicitPermission(moduleName, ['EDIT']));
    }
    // All active product profiles can consult schedules, setlists and songs.
    // Those screens need the people directory while legacy permission mirrors
    // are being normalized, so the dependency cannot depend on those mirrors.
    function canReadOperationalDirectory() {
      return activeUser()
        && 'role' in profile().data
        && profile().data.role in ['MEMBER', 'ADMIN', 'SUPER_ADMIN'];
    }
    function ownsUserDocument(userId) { return activeUser() && request.auth.uid == userId; }
    function unchangedAuthorizationFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'uid', 'permissions', 'accessProfile']);
    }
    function adminKeepsPrivilegeFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'accessProfile']);
    }
    function validCreatedUser(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.active is bool
        && request.resource.data.role in ['MEMBER', 'ADMIN', 'SUPER_ADMIN'];
    }
    function validPermissionDocument(permissionId) {
      return request.resource.data.userId is string
        && request.resource.data.module in ['dashboard', 'users', 'permissions', 'unavailability', 'events', 'schedules', 'setlists', 'songs', 'audit']
        && request.resource.data.level in ['READ', 'EDIT']
        && permissionId == request.resource.data.userId + '__' + request.resource.data.module;
    }
    function validEventDocument(eventId) {
      return activeUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is timestamp
        && request.resource.data.status in ['PLANNED', 'CONFIRMED', 'CANCELLED', 'COMPLETED']
        && request.resource.data.scheduleId == 'schedule_' + eventId
        && request.resource.data.setlistId == 'setlist_' + eventId
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy == request.auth.uid
        && (!('time' in request.resource.data) || request.resource.data.time == null || (request.resource.data.time is string && request.resource.data.time.size() == 5))
        && (!('description' in request.resource.data) || request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 1000))
        && (!('location' in request.resource.data) || request.resource.data.location == null || (request.resource.data.location is string && request.resource.data.location.size() <= 160))
        && (!('theme' in request.resource.data) || request.resource.data.theme == null || (request.resource.data.theme is string && request.resource.data.theme.size() <= 160));
    }
    function validEventCreate(eventId) {
      return validEventDocument(eventId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['PLANNED', 'CONFIRMED'];
    }
    function linkedEventBundleConsistent(eventId) {
      let linkedSchedulePath = /databases/$(database)/documents/schedules/$(request.resource.data.scheduleId);
      let linkedSetlistPath = /databases/$(database)/documents/setlists/$(request.resource.data.setlistId);
      return existsAfter(linkedSchedulePath)
        && existsAfter(linkedSetlistPath)
        && getAfter(linkedSchedulePath).data.eventId == eventId
        && getAfter(linkedSchedulePath).data.eventDate == request.resource.data.date
        && getAfter(linkedSchedulePath).data.eventTime == request.resource.data.time
        && getAfter(linkedSetlistPath).data.eventId == eventId
        && getAfter(linkedSetlistPath).data.scheduleId == request.resource.data.scheduleId
        && getAfter(linkedSetlistPath).data.eventDate == request.resource.data.date
        && getAfter(linkedSetlistPath).data.eventTime == request.resource.data.time
        && (
          (request.resource.data.status == 'CANCELLED' && getAfter(linkedSchedulePath).data.status == 'CANCELLED' && getAfter(linkedSetlistPath).data.status == 'CANCELLED')
          || (request.resource.data.status == 'COMPLETED' && getAfter(linkedSchedulePath).data.status == 'COMPLETED' && getAfter(linkedSetlistPath).data.status == 'COMPLETED')
          || (request.resource.data.status in ['PLANNED', 'CONFIRMED'] && getAfter(linkedSchedulePath).data.status in ['DRAFT', 'COMPLETE'] && getAfter(linkedSetlistPath).data.status in ['DRAFT', 'READY'])
        );
    }
    function validEventUpdate(eventId) {
      return validEventDocument(eventId)
        && resource.data.status in ['PLANNED', 'CONFIRMED']
        && request.resource.data.createdBy == resource.data.createdBy
        && linkedEventBundleConsistent(eventId);
    }
    function validEventDelete() {
      let linkedSchedulePath = /databases/$(database)/documents/schedules/$(resource.data.scheduleId);
      let linkedSetlistPath = /databases/$(database)/documents/setlists/$(resource.data.setlistId);
      return resource.data.status in ['PLANNED', 'CONFIRMED', 'CANCELLED', 'COMPLETED']
        && !existsAfter(linkedSchedulePath)
        && !existsAfter(linkedSetlistPath);
    }

    function eventManagedScheduleWrite(scheduleId) {
      let eventId = request.resource.data.eventId;
      let linkedEventPath = eventPath(eventId);
      return canEdit('events')
        && eventId is string
        && scheduleId == 'schedule_' + eventId
        && existsAfter(linkedEventPath)
        && getAfter(linkedEventPath).data.scheduleId == scheduleId
        && request.resource.data.eventDate == getAfter(linkedEventPath).data.date
        && request.resource.data.eventTime == getAfter(linkedEventPath).data.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (getAfter(linkedEventPath).data.status == 'CANCELLED' && request.resource.data.status == 'CANCELLED')
          || (getAfter(linkedEventPath).data.status == 'COMPLETED' && request.resource.data.status == 'COMPLETED')
          || (getAfter(linkedEventPath).data.status in ['PLANNED', 'CONFIRMED'] && request.resource.data.status in ['DRAFT', 'COMPLETE'])
        );
    }
    function eventManagedScheduleUpdate(scheduleId) {
      return eventManagedScheduleWrite(scheduleId)
        && resource.data.eventId == request.resource.data.eventId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventDate', 'eventTime', 'status', 'updatedBy', 'updatedAt']);
    }
    function eventManagedScheduleDelete(scheduleId) {
      let eventId = resource.data.eventId;
      let linkedEventPath = eventPath(eventId);
      return canEdit('events')
        && eventId is string
        && scheduleId == 'schedule_' + eventId
        && exists(linkedEventPath)
        && get(linkedEventPath).data.scheduleId == scheduleId
        && !existsAfter(linkedEventPath);
    }

    function eventManagedSetlistWrite(setlistId) {
      let eventId = request.resource.data.eventId;
      let linkedEventPath = eventPath(eventId);
      return canEdit('events')
        && eventId is string
        && setlistId == 'setlist_' + eventId
        && existsAfter(linkedEventPath)
        && getAfter(linkedEventPath).data.setlistId == setlistId
        && request.resource.data.scheduleId == getAfter(linkedEventPath).data.scheduleId
        && request.resource.data.eventDate == getAfter(linkedEventPath).data.date
        && request.resource.data.eventTime == getAfter(linkedEventPath).data.time
        && request.resource.data.updatedBy == request.auth.uid
        && (
          (getAfter(linkedEventPath).data.status == 'CANCELLED' && request.resource.data.status == 'CANCELLED')
          || (getAfter(linkedEventPath).data.status == 'COMPLETED' && request.resource.data.status == 'COMPLETED')
          || (getAfter(linkedEventPath).data.status in ['PLANNED', 'CONFIRMED'] && request.resource.data.status in ['DRAFT', 'READY'])
        );
    }
    function eventManagedSetlistUpdate(setlistId) {
      return eventManagedSetlistWrite(setlistId)
        && resource.data.eventId == request.resource.data.eventId
        && resource.data.scheduleId == request.resource.data.scheduleId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventDate', 'eventTime', 'status', 'updatedBy', 'updatedAt']);
    }
    function eventManagedSetlistDelete(setlistId) {
      let eventId = resource.data.eventId;
      let linkedEventPath = eventPath(eventId);
      return canEdit('events')
        && eventId is string
        && setlistId == 'setlist_' + eventId
        && exists(linkedEventPath)
        && get(linkedEventPath).data.setlistId == setlistId
        && !existsAfter(linkedEventPath);
    }

    function eventCascadeScheduleMemberDelete() {
      let linkedSchedulePath = schedulePath(resource.data.scheduleId);
      return canEdit('events')
        && resource.data.scheduleId is string
        && exists(linkedSchedulePath)
        && exists(eventPath(get(linkedSchedulePath).data.eventId))
        && get(eventPath(get(linkedSchedulePath).data.eventId)).data.scheduleId == resource.data.scheduleId
        && !existsAfter(linkedSchedulePath)
        && !existsAfter(eventPath(get(linkedSchedulePath).data.eventId));
    }
    function eventCascadeSetlistSongDelete() {
      let linkedSetlistPath = setlistPath(resource.data.setlistId);
      return canEdit('events')
        && resource.data.setlistId is string
        && exists(linkedSetlistPath)
        && exists(eventPath(get(linkedSetlistPath).data.eventId))
        && get(eventPath(get(linkedSetlistPath).data.eventId)).data.setlistId == resource.data.setlistId
        && !existsAfter(linkedSetlistPath)
        && !existsAfter(eventPath(get(linkedSetlistPath).data.eventId));
    }

    function validUnavailabilityDocument() {
      return request.resource.data.userId is string
        && request.resource.data.date is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt >= request.resource.data.date
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && (!('period' in request.resource.data) || request.resource.data.period == null || request.resource.data.period in ['MORNING', 'AFTERNOON', 'EVENING'])
        && (!('eventId' in request.resource.data) || request.resource.data.eventId == null || request.resource.data.eventId is string)
        && (!('note' in request.resource.data) || request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 240));
    }
    function ownUnavailabilityCreate() {
      return activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function administrativeUnavailabilityWrite() {
      return isAdmin()
        && canEdit('unavailability')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validUnavailabilityUpdate() {
      return validUnavailabilityDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && resource.data.endAt >= request.time
        && request.resource.data.endAt >= request.time;
    }
    function validAuditLogDocument() {
      return activeUser()
        && request.resource.data.keys().hasAll(['actorUserId', 'action', 'entityType', 'entityId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['actorUserId', 'actorUserEmail', 'actorUserName', 'action', 'entityType', 'entityId', 'createdAt', 'details', 'before', 'after', 'reason'])
        && request.resource.data.actorUserId == request.auth.uid
        && (!('actorUserEmail' in request.resource.data) || request.resource.data.actorUserEmail == null || (request.resource.data.actorUserEmail is string && request.resource.data.actorUserEmail.size() <= 320))
        && (!('actorUserName' in request.resource.data) || request.resource.data.actorUserName == null || (request.resource.data.actorUserName is string && request.resource.data.actorUserName.size() <= 160))
        && request.resource.data.action is string
        && request.resource.data.action.size() >= 3
        && request.resource.data.action.size() <= 80
        && request.resource.data.action.matches('^[A-Z0-9_]+$')
        && request.resource.data.entityType is string
        && request.resource.data.entityType.size() > 0
        && request.resource.data.entityType.size() <= 80
        && request.resource.data.entityId is string
        && request.resource.data.entityId.size() > 0
        && request.resource.data.entityId.size() <= 256
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow get: if (supportedProvider() && request.auth.uid == userId) || canReadOperationalDirectory() || canRead('users') || canRead('permissions') || (isAdmin() && canEdit('unavailability')) || canRead('schedules') || canRead('setlists') || canRead('songs');
      allow list: if canReadOperationalDirectory() || canRead('users') || canRead('permissions') || (isAdmin() && canEdit('unavailability')) || canRead('schedules') || canRead('setlists') || canRead('songs');
      allow create: if validCreatedUser(userId) && (isSuperAdmin() || (isAdmin() && canEdit('users') && request.resource.data.role == 'MEMBER'));
      allow update: if isSuperAdmin()
        || (canEdit('users') && resource.data.role != 'SUPER_ADMIN' && request.resource.data.role == resource.data.role && adminKeepsPrivilegeFields())
        || (ownsUserDocument(userId) && unchangedAuthorizationFields());
      allow delete: if false;
    }

    match /permissions/{permissionId} {
      allow get: if isSuperAdmin() || canRead('permissions') || ownPermissionSlot(permissionId);
      allow list: if isSuperAdmin() || canRead('permissions');
      allow create, update: if isSuperAdmin() && validPermissionDocument(permissionId);
      allow delete: if isSuperAdmin();
    }

    match /ministryFunctions/{documentId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /userFunctions/{documentId} {
      allow read: if canReadOperationalDirectory() || canRead('users') || canRead('schedules') || canRead('songs');
      allow write: if canEdit('users');
    }
    match /events/{documentId} {
      allow read: if canRead('events') || canRead('schedules') || canRead('setlists') || canRead('dashboard');
      allow create: if canEdit('events') && validEventCreate(documentId) && linkedEventBundleConsistent(documentId);
      allow update: if canEdit('events') && validEventUpdate(documentId);
      allow delete: if canEdit('events') && validEventDelete();
    }
    match /unavailability/{documentId} {
      allow read: if canRead('schedules') || (activeUser() && resource.data.userId == request.auth.uid) || (isAdmin() && canRead('unavailability'));
      allow create: if validUnavailabilityDocument() && (ownUnavailabilityCreate() || administrativeUnavailabilityWrite());
      allow update: if validUnavailabilityUpdate() && (
        (activeUser() && resource.data.userId == request.auth.uid)
        || (isAdmin() && canEdit('unavailability'))
      );
      allow delete: if resource.data.endAt >= request.time && (
        (activeUser() && resource.data.userId == request.auth.uid)
        || (isAdmin() && canEdit('unavailability'))
      );
    }
    match /schedules/{documentId} {
      allow read: if canRead('schedules') || canRead('setlists') || canRead('dashboard') || canEdit('events');
      allow create: if canEdit('schedules') || eventManagedScheduleWrite(documentId);
      allow update: if canEdit('schedules') || eventManagedScheduleUpdate(documentId);
      allow delete: if canEdit('schedules') || eventManagedScheduleDelete(documentId);
    }
    match /scheduleMembers/{documentId} {
      allow read: if canRead('schedules') || canRead('setlists') || canRead('dashboard') || canEdit('events');
      allow create, update: if canEdit('schedules');
      allow delete: if canEdit('schedules') || eventCascadeScheduleMemberDelete();
    }
    match /setlists/{documentId} {
      allow read: if canRead('setlists') || canRead('dashboard') || canEdit('events');
      allow create: if canEdit('setlists') || eventManagedSetlistWrite(documentId);
      allow update: if canEdit('setlists') || eventManagedSetlistUpdate(documentId);
      allow delete: if canEdit('setlists') || eventManagedSetlistDelete(documentId);
    }
    match /setlistSongs/{documentId} {
      allow read: if canRead('setlists') || canEdit('events');
      allow create, update: if canEdit('setlists');
      allow delete: if canEdit('setlists') || eventCascadeSetlistSongDelete();
    }
    match /songs/{documentId} { allow read: if canRead('songs') || canRead('setlists'); allow write: if canEdit('songs'); }
    match /songMinisterKeys/{documentId} { allow read: if canRead('songs') || canRead('setlists'); allow write: if canEdit('songs'); }
    match /settings/{documentId} {
      allow read: if activeUser();
      allow create, update: if isAdmin()
        && documentId == 'scheduleTemplate'
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /auditLogs/{documentId} {
      allow read: if canRead('audit');
      allow create: if validAuditLogDocument();
      allow update, delete: if false;
    }
    match /lgpdConsents/{documentId} {
      allow read: if isSuperAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}