rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }

    // Somente contas Google ou e-mail/senha cadastradas no Firebase acessam os dados.
    // Os perfis admin/member serão aplicados junto ao módulo de escalas.
    match /{document=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
