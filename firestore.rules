rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function supportedProvider() { return signedIn() && request.auth.token.firebase.sign_in_provider in ['google.com', 'password']; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return supportedProvider() && exists(profilePath(request.auth.uid)); }
    function profile() { return get(profilePath(request.auth.uid)); }
    function activeUser() { return supportedProvider() && hasProfile() && profile().data.active == true; }
    function hasRole(role) { return activeUser() && profile().data.role == role; }
    function hasClaim(claimName) { return signedIn() && claimName in request.auth.token && request.auth.token[claimName] == true; }

    function bootstrapSuperAdminIdentity() {
      return supportedProvider() && 'email' in request.auth.token && request.auth.token.email == 'davitads@gmail.com';
    }
    function initialSuperAdmin() { return bootstrapSuperAdminIdentity() && (!hasProfile() || profile().data.active == true); }
    function isSuperAdmin() {
      return initialSuperAdmin() || (activeUser() && (
        hasClaim('superAdmin') || ('role' in request.auth.token && request.auth.token.role == 'SUPER_ADMIN') || hasRole('SUPER_ADMIN')
      ));
    }
    function isAdmin() {
      return isSuperAdmin() || (activeUser() && (
        hasClaim('admin') || ('role' in request.auth.token && request.auth.token.role == 'ADMIN') || hasRole('ADMIN')
      ));
    }

    function permissionPath(moduleName) {
      return /databases/$(database)/documents/permissions/$(request.auth.uid + '__' + moduleName);
    }
    function ownPermissionSlot(permissionId) {
      return activeUser() && permissionId in [
        request.auth.uid + '__dashboard',
        request.auth.uid + '__users',
        request.auth.uid + '__permissions',
        request.auth.uid + '__unavailability',
        request.auth.uid + '__events',
        request.auth.uid + '__schedules',
        request.auth.uid + '__setlists',
        request.auth.uid + '__songs',
        request.auth.uid + '__audit'
      ];
    }
    function explicitPermission(moduleName, acceptedLevels) {
      return activeUser()
        && exists(permissionPath(moduleName))
        && get(permissionPath(moduleName)).data.userId == request.auth.uid
        && get(permissionPath(moduleName)).data.module == moduleName
        && get(permissionPath(moduleName)).data.level in acceptedLevels;
    }
    function canRead(moduleName) {
      return isSuperAdmin()
        || (activeUser() && moduleName in ['setlists', 'songs'])
        || explicitPermission(moduleName, ['READ', 'EDIT']);
    }
    function canEdit(moduleName) { return isSuperAdmin() || explicitPermission(moduleName, ['EDIT']); }
    function ownsUserDocument(userId) { return activeUser() && request.auth.uid == userId; }
    function unchangedAuthorizationFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'uid', 'permissions']);
    }
    function adminKeepsPrivilegeFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']);
    }
    function validCreatedUser(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.active is bool
        && request.resource.data.role in ['MEMBER', 'ADMIN', 'SUPER_ADMIN'];
    }
    function validPermissionDocument(permissionId) {
      return request.resource.data.userId is string
        && request.resource.data.module in ['dashboard', 'users', 'permissions', 'unavailability', 'events', 'schedules', 'setlists', 'songs', 'audit']
        && request.resource.data.level in ['READ', 'EDIT']
        && permissionId == request.resource.data.userId + '__' + request.resource.data.module;
    }
    function validEventDocument(eventId) {
      return activeUser()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is timestamp
        && request.resource.data.status in ['PLANNED', 'CONFIRMED', 'CANCELLED', 'COMPLETED']
        && request.resource.data.scheduleId == 'schedule_' + eventId
        && request.resource.data.setlistId == 'setlist_' + eventId
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy == request.auth.uid
        && (!('time' in request.resource.data) || request.resource.data.time == null || (request.resource.data.time is string && request.resource.data.time.size() == 5))
        && (!('description' in request.resource.data) || request.resource.data.description == null || (request.resource.data.description is string && request.resource.data.description.size() <= 1000))
        && (!('location' in request.resource.data) || request.resource.data.location == null || (request.resource.data.location is string && request.resource.data.location.size() <= 160))
        && (!('theme' in request.resource.data) || request.resource.data.theme == null || (request.resource.data.theme is string && request.resource.data.theme.size() <= 160));
    }
    function validEventCreate(eventId) {
      return validEventDocument(eventId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['PLANNED', 'CONFIRMED'];
    }
    function linkedEventBundleConsistent(eventId) {
      let schedulePath = /databases/$(database)/documents/schedules/$(request.resource.data.scheduleId);
      let setlistPath = /databases/$(database)/documents/setlists/$(request.resource.data.setlistId);
      return existsAfter(schedulePath)
        && existsAfter(setlistPath)
        && getAfter(schedulePath).data.eventId == eventId
        && getAfter(schedulePath).data.eventDate == request.resource.data.date
        && getAfter(schedulePath).data.eventTime == request.resource.data.time
        && getAfter(setlistPath).data.eventId == eventId
        && getAfter(setlistPath).data.scheduleId == request.resource.data.scheduleId
        && getAfter(setlistPath).data.eventDate == request.resource.data.date
        && getAfter(setlistPath).data.eventTime == request.resource.data.time
        && (
          (request.resource.data.status == 'CANCELLED' && getAfter(schedulePath).data.status == 'CANCELLED' && getAfter(setlistPath).data.status == 'CANCELLED')
          || (request.resource.data.status == 'COMPLETED' && getAfter(schedulePath).data.status == 'COMPLETED' && getAfter(setlistPath).data.status == 'COMPLETED')
          || (request.resource.data.status in ['PLANNED', 'CONFIRMED'] && getAfter(schedulePath).data.status in ['DRAFT', 'COMPLETE'] && getAfter(setlistPath).data.status in ['DRAFT', 'READY'])
        );
    }
    function validEventUpdate(eventId) {
      return validEventDocument(eventId)
        && resource.data.status in ['PLANNED', 'CONFIRMED']
        && request.resource.data.createdBy == resource.data.createdBy
        && linkedEventBundleConsistent(eventId);
    }
    function validEventDelete() {
      let schedulePath = /databases/$(database)/documents/schedules/$(resource.data.scheduleId);
      let setlistPath = /databases/$(database)/documents/setlists/$(resource.data.setlistId);
      return resource.data.status in ['PLANNED', 'CONFIRMED', 'CANCELLED', 'COMPLETED']
        && !existsAfter(schedulePath)
        && !existsAfter(setlistPath);
    }
    function validUnavailabilityDocument() {
      return request.resource.data.userId is string
        && request.resource.data.date is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.endAt >= request.resource.data.date
        && request.resource.data.createdBy is string
        && request.resource.data.updatedBy is string
        && (!('period' in request.resource.data) || request.resource.data.period == null || request.resource.data.period in ['MORNING', 'AFTERNOON', 'EVENING'])
        && (!('eventId' in request.resource.data) || request.resource.data.eventId == null || request.resource.data.eventId is string)
        && (!('note' in request.resource.data) || request.resource.data.note == null || (request.resource.data.note is string && request.resource.data.note.size() <= 240));
    }
    function ownUnavailabilityCreate() {
      return activeUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function administrativeUnavailabilityWrite() {
      return isAdmin()
        && canEdit('unavailability')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
    }
    function validUnavailabilityUpdate() {
      return validUnavailabilityDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && resource.data.endAt >= request.time
        && request.resource.data.endAt >= request.time;
    }

    match /users/{userId} {
      allow get: if (supportedProvider() && request.auth.uid == userId) || canRead('users') || canRead('permissions') || (isAdmin() && canEdit('unavailability')) || canRead('setlists') || canRead('songs');
      allow list: if canRead('users') || canRead('permissions') || (isAdmin() && canEdit('unavailability')) || canRead('setlists') || canRead('songs');
      allow create: if validCreatedUser(userId) && (isSuperAdmin() || (isAdmin() && canEdit('users') && request.resource.data.role == 'MEMBER'));
      allow update: if isSuperAdmin()
        || (canEdit('users') && resource.data.role != 'SUPER_ADMIN' && request.resource.data.role == resource.data.role && adminKeepsPrivilegeFields())
        || (ownsUserDocument(userId) && unchangedAuthorizationFields());
      allow delete: if false;
    }

    match /permissions/{permissionId} {
      allow get: if isSuperAdmin() || canRead('permissions') || ownPermissionSlot(permissionId);
      allow list: if isSuperAdmin() || canRead('permissions');
      allow create, update: if isSuperAdmin() && validPermissionDocument(permissionId);
      allow delete: if isSuperAdmin();
    }

    match /ministryFunctions/{documentId} {
      allow read: if activeUser();
      allow write: if isAdmin();
    }
    match /userFunctions/{documentId} {
      allow read: if canRead('users') || canRead('songs');
      allow write: if canEdit('users');
    }
    match /events/{documentId} {
      allow read: if canRead('events') || canRead('setlists') || canRead('dashboard');
      allow create: if canEdit('events') && canEdit('schedules') && canEdit('setlists') && validEventCreate(documentId) && linkedEventBundleConsistent(documentId);
      allow update: if canEdit('events') && validEventUpdate(documentId);
      allow delete: if canEdit('events') && canEdit('schedules') && canEdit('setlists') && validEventDelete();
    }
    match /unavailability/{documentId} {
      allow read: if (activeUser() && resource.data.userId == request.auth.uid) || (isAdmin() && canRead('unavailability'));
      allow create: if validUnavailabilityDocument() && (ownUnavailabilityCreate() || administrativeUnavailabilityWrite());
      allow update: if validUnavailabilityUpdate() && (
        (activeUser() && resource.data.userId == request.auth.uid)
        || (isAdmin() && canEdit('unavailability'))
      );
      allow delete: if resource.data.endAt >= request.time && (
        (activeUser() && resource.data.userId == request.auth.uid)
        || (isAdmin() && canEdit('unavailability'))
      );
    }
    match /schedules/{documentId} { allow read: if canRead('schedules') || canRead('setlists') || canRead('dashboard'); allow write: if canEdit('schedules'); }
    match /scheduleMembers/{documentId} { allow read: if canRead('schedules') || canRead('setlists') || canRead('dashboard'); allow write: if canEdit('schedules'); }
    match /setlists/{documentId} { allow read: if canRead('setlists') || canRead('dashboard'); allow write: if canEdit('setlists'); }
    match /setlistSongs/{documentId} { allow read: if canRead('setlists'); allow write: if canEdit('setlists'); }
    match /songs/{documentId} { allow read: if canRead('songs') || canRead('setlists'); allow write: if canEdit('songs'); }
    match /songMinisterKeys/{documentId} { allow read: if canRead('songs') || canRead('setlists'); allow write: if canEdit('songs'); }
    match /settings/{documentId} {
      allow read: if activeUser();
      allow create, update: if isAdmin()
        && documentId == 'scheduleTemplate'
        && request.resource.data.slots is list
        && request.resource.data.slots.size() > 0
        && request.resource.data.version is int
        && request.resource.data.version > 0
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /auditLogs/{documentId} {
      allow read: if canRead('audit');
      allow create: if activeUser() && request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if false;
    }
    match /lgpdConsents/{documentId} {
      allow read: if isSuperAdmin() || (activeUser() && resource.data.userId == request.auth.uid);
      allow create: if activeUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}